# ==============================================================================
# AI Recruiter Copilot — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: "groq", "gemini", "openai", "openrouter", "mock"
# Note: If no API key is provided, the backend automatically runs in offline
# deterministic mock mode for local testing and CI/CD without crashing.
LLM_PROVIDER=groq

# GROQ API (RECOMMENDED: Lowest memory footprint, ultra-fast ~200ms responses, free tier)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini API (Alternative: Use lightweight flash-lite to save RAM & quota)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Options: gemini-2.0-flash-lite, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash-lite

# OpenAI API (Alternative)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter API (Alternative multi-model routing)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Defaults to SQLite inside backend/app/db/recruiter_copilot.db (Zero-config, auto-creates)
# For production (Render, Supabase, Neon, PostgreSQL):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///backend/app/db/recruiter_copilot.db

# ------------------------------------------------------------------------------
# 3. SMTP Email Dispatch Configuration
# ------------------------------------------------------------------------------
# Set to "true" to print email payloads cleanly to console (zero SMTP dependency, perfect for testing)
# Set to "false" to send real emails via your corporate or personal SMTP server (e.g. Gmail)
MOCK_SMTP=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
HR_EMAIL=hr-screening@company.com

# ------------------------------------------------------------------------------
# 4. Server & Deployment
# ------------------------------------------------------------------------------
PORT=8000
ENV=production
